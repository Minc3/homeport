{
  "_comment": "Install as /etc/failover/frontend.json with mode 0600. Everything else is configured in the portal.",

  "role": "frontend",

  "_psk": "Must be identical on both hosts. Generate one with: openssl rand -hex 32",
  "psk": "CHANGE-ME-openssl-rand-hex-32",

  "state_dir": "/var/lib/failover",
  "db_path": "/var/lib/failover/failover.db",

  "_portal_listen": "Bind to the admin WireGuard address, not the public one. WireGuard already does the encryption and peer authentication, so there is no certificate to manage and no public TCP surface to scan.",
  "portal_listen": "10.98.0.2:8088",

  "_public_iface": "The interface facing the internet, e.g. ens3. Written by install-frontend.sh, which detects it from the default route and asks you to confirm. It seeds Frontend -> Public interface the first time the agent creates its database and is ignored on every start after that, so the portal stays the place to change it. Leave it out to keep the shipped default of eth0.",
  "public_iface": "eth0",

  "overlay": {
    "_comment": "These two addresses never change. Failover swaps only the interface behind them, which is why live game sessions and established TCP connections survive a switch.",
    "frontend_ip": "10.99.0.1",
    "backend_ip": "10.99.0.2",
    "_device": "Optional. The dummy interface the overlay address lives on; defaults to dummy0. Set it here on both hosts, not in the portal - the two must agree and the change would tear down the channel it has to travel over.",
    "device": "dummy0",
    "_subnet": "The overlay range. install-frontend.sh and install-backend.sh now write the /24 the two addresses above sit in, and it must be identical on both hosts. It is what makes a linker - an extra host published through this backend - configurable at all, and it cannot be set from the portal, so having it in advance is what keeps adding a second machine a portal-only job. On a site with one host at the far end everything it enables matches nothing: no other address in the range exists. Set it to \"\" to opt out, and check AllowedIPs on the frontend's peers covers the range - the shipped setup already puts 10.99.0.0/24 there.",
    "subnet": "10.99.0.0/24",
    "probe_port": 51999,
    "control_port": 51998
  }
}
