{
  "_comment": "Install as /etc/failover/backend.json with mode 0600. The backend needs nothing else: paths, quotas and thresholds are pushed down from the portal and cached locally.",

  "role": "backend",

  "_psk": "Must match the frontend exactly.",
  "psk": "CHANGE-ME-openssl-rand-hex-32",

  "state_dir": "/var/lib/failover",

  "overlay": {
    "frontend_ip": "10.99.0.1",
    "backend_ip": "10.99.0.2",
    "_device": "Optional. The dummy interface the overlay address lives on; defaults to dummy0. Set it here on both hosts, not in the portal - the two must agree and the change would tear down the channel it has to travel over.",
    "device": "dummy0",
    "_subnet": "Only for a site that runs linker agents - extra hosts published through this backend. Leave it out otherwise: a site with one host at the far end has no reason to route a range down its tunnel. Must be identical on both hosts, and covered by AllowedIPs on the frontend's peers - the shipped setup already puts 10.99.0.0/24 there.",
    "subnet": "",
    "probe_port": 51999,
    "control_port": 51998
  }
}
